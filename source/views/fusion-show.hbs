<section class='panel'>
	<h2>
		Show {{fusion.name}}
		<a href='{{basePath}}/fusion/{{fusion._id}}/json'>
			<code>(JSON)</code>
		</a>
	</h2>

	<div class='detail-grid'>
		<section>
			<h3>Gems</h3>
			{{#each fusion.gems}}
				<p>{{this.name}}</p>
			{{/each}}
		</section>

		<section>
			<h3>Weapons</h3>
			<p>{{fusion.weapon}}</p>
		</section>

		<section>
			<h3>Powers</h3>
			<p>{{fusion.power}}</p>
		</section>
	</div>

	<p>
		<a
			href='{{basePath}}/fusion/{{fusion._id}}/edit'
			class='button-link'
		>
			Edit
		</a>
	</p>
</section>
