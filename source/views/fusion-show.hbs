<h2>
	Show {{fusion.name}}
	<a href='/fusion/{{fusion._id}}/json'>
		<code>(JSON)</code>
	</a>
</h2>

<h3>Gems</h3>
{{#each fusion.gems}}
	<p>{{this.name}}</p>
{{/each}}

<h3>Weapons</h3>
<p>{{fusion.weapon}}</p>

<h3>Powers</h3>
<p>{{fusion.power}}</p>

<h4>
	<a
		href='/fusion/{{fusion._id}}/edit'
		style='outline:solid'
	>
		Edit
	</a>
</h4>
