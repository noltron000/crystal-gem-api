<h2>Create a gem</h2>

{{!-- Add the "Create Gem" form. --}}
<form
	action='{{basePath}}/gem'
	method='post'
>

	<fieldset>
		<legend>Basics</legend>

		<div>
			<label for='name'>
				Gem
			</label>
			<br />
			<input
				id='name'
				name='name'
				type='text'
				maxlength='100'
				required
			/>
		</div>
	</fieldset>

	<fieldset>
		<legend>Abilities</legend>

		<div>
			<label for='weapon'>
				Signature Weapon
			</label>
			<br />
			<input
				id='weapon'
				name='weapon'
				type='text'
				maxlength='500'
				required
			/>
		</div>

		<div>
			<label for='power'>
				Secret Power
			</label>
			<br />
			<input
				id='power'
				name='power'
				type='text'
				maxlength='500'
				required
			/>
		</div>

	</fieldset>
	<button type='submit'>
		Submit
	</button>

</form>
