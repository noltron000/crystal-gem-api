<h2>Create a fusion</h2>

{{!-- Add the "Create Fusion" form. --}}
<form
	action='{{basePath}}/fusion'
	method='post'
>

	<fieldset>
		<legend>Basics</legend>

		<div>
			<label for='name'>
				Fusion Gem
			</label>
			<br />
			<input
				id='name'
				name='name'
				type='text'
				maxlength='100'
				required
			/>
		</div>

		{{#each gems}}
			<div>
				<input
					id='{{this._id}}'
					name='gems[]' {{!-- Express parses this bracketed name as an array. --}}
					type='checkbox'
					value='{{this._id}}'
				/>
				<label for='{{this._id}}'>
					{{this.name}}
				</label>
			</div>
		{{/each}}

	</fieldset>

	<fieldset>
		<legend>Abilities</legend>

		<div>
			<label for='weapon'>
				Signature Weapon
			</label>
			<br />
			<input
				id='weapon'
				name='weapon'
				type='text'
				maxlength='500'
				required
			/>
		</div>

		<div>
			<label for='power'>
				Secret Power
			</label>
			<br />
			<input
				id='power'
				name='power'
				type='text'
				maxlength='500'
				required
			/>
		</div>

	</fieldset>
	<button type='submit'>
		Submit
	</button>

</form>
