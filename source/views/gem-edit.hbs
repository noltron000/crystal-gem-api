<h2>Edit {{gem.name}}</h2>

{{!-- Add the "Edit Gem" form. --}}
<form
	action='{{basePath}}/gem/{{gem._id}}?_method=PUT'
	method='post'
>

	<fieldset>
		<legend>Basics</legend>

		<div>
			<label for='name'>
				Gem
			</label>
			<br />
			<input
				id='name'
				name='name'
				type='text'
				maxlength='100'
				required
				value='{{gem.name}}'
			/>
		</div>
	</fieldset>

	<fieldset>
		<legend>Abilities</legend>

		<div>
			<label for='weapon'>
				Signature Weapon
			</label>
			<br />
			<input
				id='weapon'
				name='weapon'
				type='text'
				maxlength='500'
				required
				value='{{gem.weapon}}'
			/>
		</div>

		<div>
			<label for='power'>
				Secret Power
			</label>
			<br />
			<input
				id='power'
				name='power'
				type='text'
				maxlength='500'
				required
				value='{{gem.power}}'
			/>
		</div>

	</fieldset>
	<button type='submit'>
		Update
	</button>
</form>

<form
	action='{{basePath}}/gem/{{gem._id}}?_method=DELETE'
	method='post'
>
	<button type='submit'>
		Delete
	</button>
</form>
