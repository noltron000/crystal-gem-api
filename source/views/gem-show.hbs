<h2>
	Show {{gem.name}}
	<a href='{{basePath}}/gem/{{gem._id}}/json'>
		<code>(JSON)</code>
	</a>
</h2>

<h3>Fusions</h3>
{{#each gem.fusions}}
	<p>{{this.name}}</p>
{{/each}}

<h3>Weapons</h3>
<p>{{gem.weapon}}</p>

<h3>Powers</h3>
<p>{{gem.power}}</p>

<h4>
	<a
		href='{{basePath}}/gem/{{gem._id}}/edit'
		style='outline:solid'
	>
		Edit
	</a>
</h4>
