<section class='panel'>
	<h2>
		Show {{gem.name}}
		<a href='{{basePath}}/gem/{{gem._id}}/json'>
			<code>(JSON)</code>
		</a>
	</h2>

	<div class='detail-grid'>
		<section>
			<h3>Fusions</h3>
			{{#each gem.fusions}}
				<p>{{this.name}}</p>
			{{/each}}
		</section>

		<section>
			<h3>Weapons</h3>
			<p>{{gem.weapon}}</p>
		</section>

		<section>
			<h3>Powers</h3>
			<p>{{gem.power}}</p>
		</section>
	</div>

	<p>
		<a
			href='{{basePath}}/gem/{{gem._id}}/edit'
			class='button-link'
		>
			Edit
		</a>
	</p>
</section>
