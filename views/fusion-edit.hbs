<h2>Edit {{fusion.name}}</h2>

{{!-- Add the "Edit Fusion" form. --}}
<form
	action='/fusion/{{fusion._id}}?_method=PUT'
	method='post'
>

	<fieldset>
		<legend>Basics</legend>

		<div>
			<label for='name'>
				Fusion Gem
			</label>
			<br />
			<input
				id='name'
				name='name'
				type='text'
				value='{{fusion.name}}'
			/>
		</div>

		{{#each gems}}
			<div>
				<input
					id='{{this._id}}'
					name='gems[]' {{!-- Express parses this bracketed name as an array. --}}
					type='checkbox'
					value='{{this._id}}'
					{{#if this.selected}}checked{{/if}}
				/>
				<label for='{{this._id}}'>
					{{this.name}}
				</label>
			</div>
		{{/each}}
	</fieldset>

	<fieldset>
		<legend>Abilities</legend>

		<div>
			<label for='weapon'>
				Signature Weapon
			</label>
			<br />
			<input
				id='weapon'
				name='weapon'
				type='text'
				value='{{fusion.weapon}}'
			/>
		</div>

		<div>
			<label for='power'>
				Secret Power
			</label>
			<br />
			<input
				id='power'
				name='power'
				type='text'
				value='{{fusion.power}}'
			/>
		</div>

	</fieldset>
	<button type='submit'>
		Update
	</button>

</form>

<form
	action='/fusion/{{fusion._id}}?_method=DELETE'
	method='post'
>
	<button type='submit'>
		Delete
	</button>
</form>
