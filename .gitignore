# Ignore log files.
logs
*.log
npm-debug.log*

# Ignore runtime data files.
pids
*.pid
*.seed

# Ignore IDE-specific files.
.idea

# Ignore files generated by operating systems.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
ehthumbs.db
Icon?
Thumbs.db

# Ignore files generated by Babel's ES6 compiler.
dist

# Ignore coverage instrumentation generated by jscoverage or JSCover.
lib-cov

# Ignore the coverage directory generated by c8.
coverage

# Ignore intermediate files generated by Grunt.
.grunt

# Ignore node-waf configuration files.
.lock-wscript

# Ignore compiled Node.js binary add-ons.
build/Release

# Ignore the installed dependency directory.
node_modules

# Ignore the optional npm cache directory.
.npm

# Ignore optional REPL history files.
.node_repl_history

# Ignore local environment configuration.
.env
