{
	"name": "auth-api-starterpack",
	"version": "1.0.0",
	"description": "A Boilerplate application for building REST APIs using express, mongoose in ES6 with code coverage",
	"author": "Dani Roxberry <dani@makeschool.com>",
	"main": "index.mjs",
	"private": false,
	"engines": {
		"node": ">=26.0.0",
		"npm": ">=5.6.0",
		"yarn": ">=1.5.1"
	},
	"scripts": {
		"start": "node index.mjs",
		"start:debug": "cross-env DEBUG=auth-api-starterpack:* yarn start",
		"lint": "prettier --check *.mjs server config",
		"precommit": "yarn lint && yarn test",
		"prepare": "husky",
		"test": "cross-env NODE_ENV=test mocha --extension mjs --ui bdd --reporter spec --colors server --recursive",
		"test:watch": "yarn test -- --watch",
		"test:coverage": "cross-env NODE_ENV=test c8 --reporter=lcov mocha --extension mjs --ui bdd --reporter spec --colors server --recursive",
		"test:check-coverage": "yarn test:coverage && c8 check-coverage"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:droxey/auth-api-starterpack.git"
	},
	"keywords": [
		"express",
		"node",
		"node.js",
		"mongodb",
		"mongoose",
		"es6",
		"mocha",
		"nyc",
		"REST",
		"API",
		"boilerplate",
		"makeschool",
		"authenticated",
		"MVC"
	],
	"dependencies": {
		"cors": "2.8.6",
		"debug": "^4.4.3",
		"dotenv": "^18.0.10",
		"express": "5.3.0",
		"express-handlebars": "9.0.6",
		"joi": "18.3.2",
		"method-override": "^3.0.0",
		"mongoose": "9.12.1"
	},
	"devDependencies": {
		"c8": "12.0.0",
		"cross-env": "10.1.0",
		"husky": "9.1.7",
		"mocha": "12.0.3",
		"prettier": "3.10.1"
	},
	"prettier": {
		"singleQuote": true,
		"semi": false
	},
	"license": "MIT",
	"c8": {
		"all": true,
		"exclude": [
			"dist/**",
			"coverage/**",
			"index.mjs"
		],
		"reporter": [
			"lcov"
		],
		"branches": 50,
		"functions": 50,
		"lines": 50,
		"statements": 50
	},
	"resolutions": {
		"glob": "14.0.6",
		"minimatch": "11.0.8"
	}
}
